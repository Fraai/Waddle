JWT_SECRET=min-32-char-random-string
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret
# MCP server (/api/mcp) — optional; leave unset to disable it. Generate a
# token with `openssl rand -hex 32`. It authenticates as MCP_USER_EMAIL,
# which must already be a real user in this DB (sign in via the browser
# once first) — the MCP endpoint never provisions an account itself.
MCP_TOKEN=generate-with-openssl-rand-hex-32
MCP_USER_EMAIL=you@fraai.agency
# Push notifications (a task's due-time reminder) — optional; leave unset to
# hide the "Notifications" toggle. Generate a keypair with:
#   node -e "const{webcrypto:c}=require('crypto');(async()=>{const{publicKey,privateKey}=await c.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']);const pub=new Uint8Array(await c.subtle.exportKey('raw',publicKey));const priv=await c.subtle.exportKey('jwk',privateKey);const b64url=b=>Buffer.from(b).toString('base64url');console.log('VAPID_PUBLIC_KEY='+b64url(pub));console.log('VAPID_PRIVATE_KEY='+priv.d);})()"
VAPID_PUBLIC_KEY=generate-a-p-256-keypair-see-above
VAPID_PRIVATE_KEY=generate-a-p-256-keypair-see-above
VAPID_SUBJECT=mailto:you@fraai.agency
