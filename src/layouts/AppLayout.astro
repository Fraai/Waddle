---
import '../styles/global.css';
import { actions } from 'astro:actions';
import { env } from 'cloudflare:workers';
import { listProjects } from '../lib/db';

interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user!;
const projects = await listProjects(env.DB, user.id);
// Every user gets an Inbox at provisioning, so this should always be found —
// but a layout can't redirect (a returned Response renders nothing), so treat
// it as "no Inbox link" rather than crashing every /app page.
const inbox = projects.find((p) => p.is_inbox === 1);
const otherProjects = projects.filter((p) => p.is_inbox === 0);
const path = Astro.url.pathname;
const isActive = (href: string) => path === href;

// Golden-angle hue spacing gives every project a distinct, stable colour
// without needing to store one.
const projectHue = (id: number) => (id * 137.5) % 360;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Todo</title>
    <script is:inline nonce={Astro.locals.cspNonce}>
      // Runs before the sidebar paints, so a collapsed preference from a
      // previous visit never flashes open first. Desktop-only concern — the
      // mobile drawer below is separate and always starts closed.
      try {
        if (localStorage.getItem('sidebarCollapsed') === 'true') {
          document.documentElement.dataset.sidebarCollapsed = 'true';
        }
        const savedFilter = localStorage.getItem('taskFilter');
        if (savedFilter === 'work' || savedFilter === 'private') {
          document.documentElement.dataset.taskFilter = savedFilter;
        }
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col md:flex-row">
    <input type="checkbox" id="nav-toggle" class="peer sr-only md:hidden" aria-label="Toggle menu" />

    <header class="mobile-topbar sticky top-0 z-10 flex items-center gap-3 border-b border-[var(--hairline)] bg-[var(--chrome)] px-4 py-3 backdrop-blur-xl backdrop-saturate-150 md:hidden">
      <label for="nav-toggle" class="hamburger grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded-[var(--r-sm)] active:bg-[var(--pressed)]">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M2 4h12M2 8h12M2 12h12" />
        </svg>
        <span class="sr-only">Open menu</span>
      </label>
      <span class="truncate text-[0.9375rem] font-semibold tracking-[-0.01em]">{title}</span>
    </header>

    <label
      for="nav-toggle"
      aria-hidden="true"
      class="fixed inset-0 z-[15] bg-black/35 opacity-0 pointer-events-none transition-opacity duration-200 peer-checked:opacity-100 peer-checked:pointer-events-auto md:hidden"
    ></label>

    <button
      id="sidebar-expand"
      type="button"
      class="sidebar-toggle sidebar-expand-btn"
      title="Show sidebar (⌘B)"
      aria-label="Show sidebar"
    >
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <rect x="2" y="3" width="12" height="10" rx="1.5" />
        <path d="M6.5 3v10" />
      </svg>
    </button>

    <aside class="sidebar fixed inset-y-0 left-0 z-20 flex w-[min(85vw,320px)] shrink-0 -translate-x-full flex-col gap-1 p-3 transition-transform duration-200 peer-checked:translate-x-0 md:sticky md:inset-y-auto md:left-auto md:top-0 md:z-auto md:h-screen md:translate-x-0">
      <div class="flex items-start justify-between px-2 pb-4 pt-2">
        <div>
          <div class="text-[0.9375rem] font-semibold tracking-[-0.01em]">Todo</div>
          <div class="text-xs" style="color: var(--text-3)">{user.email}</div>
        </div>
        <button
          id="sidebar-collapse"
          type="button"
          class="sidebar-toggle sidebar-collapse-btn"
          title="Hide sidebar (⌘B)"
          aria-label="Hide sidebar"
        >
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
            <rect x="2" y="3" width="12" height="10" rx="1.5" />
            <path d="M6.5 3v10" />
          </svg>
        </button>
      </div>

      <div class="filter-toggle mb-3" role="group" aria-label="Filter by project type">
        <button type="button" class="filter-toggle-btn" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="filter-toggle-btn" data-filter="work" aria-pressed="false">Work</button>
        <button type="button" class="filter-toggle-btn" data-filter="private" aria-pressed="false">Private</button>
      </div>

      <a href="/app/today" class="nav-item" data-astro-prefetch aria-current={isActive('/app/today') ? 'page' : undefined}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <circle cx="8" cy="8" r="5.25" />
          <path d="M8 5.2V8l1.9 1.4" />
        </svg>
        Today
      </a>

      <a href="/app/upcoming" class="nav-item" data-astro-prefetch aria-current={isActive('/app/upcoming') ? 'page' : undefined}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <rect x="2.4" y="3.2" width="11.2" height="10.4" rx="2" />
          <path d="M2.4 6.4h11.2M5.6 2v2.4M10.4 2v2.4" />
        </svg>
        Upcoming
      </a>

      <a href="/app/week" class="nav-item" data-astro-prefetch aria-current={isActive('/app/week') ? 'page' : undefined}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" />
          <path d="M4.5 3.5v9M7.5 3.5v9M10.5 3.5v9" />
        </svg>
        Week
      </a>

      {inbox && (
        <div data-project-id={inbox.id} data-project-type={inbox.type} class="flex items-center gap-1">
          <a
            href={`/app/projects/${inbox.id}`}
            class="nav-item flex-1 min-w-0"
            data-astro-prefetch
            aria-current={isActive(`/app/projects/${inbox.id}`) ? 'page' : undefined}
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
              <path d="M2.2 9.2 4 3.4h8l1.8 5.8v3a1 1 0 0 1-1 1H3.2a1 1 0 0 1-1-1z" />
              <path d="M2.2 9.2h3.2l.8 1.6h3.6l.8-1.6h3.2" />
            </svg>
            Inbox
          </a>
          <button
            type="button"
            class="project-type-badge"
            data-project-id={inbox.id}
            data-type={inbox.type}
            title={inbox.type === 'private' ? 'Private — click to mark as Work' : 'Work — click to mark as Private'}
          >
            {inbox.type === 'private' ? (
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3.5" y="7" width="9" height="6" rx="1.3" />
                <path d="M5.3 7V5.2a2.7 2.7 0 0 1 5.4 0V7" />
              </svg>
            ) : (
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5.3" width="12" height="7.5" rx="1.3" />
                <path d="M6 5.3V4.3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1M2 9h12" />
              </svg>
            )}
            <span class="sr-only">Toggle private/work</span>
          </button>
        </div>
      )}

      <div class="label-caps mt-4 mb-2 px-2">Projects</div>
      <ul id="project-list" class="flex flex-col gap-1">
        {otherProjects.map((project) => (
          <li data-project-id={project.id} data-project-type={project.type} class="flex items-center gap-1">
            <a
              href={`/app/projects/${project.id}`}
              class="nav-item flex-1 min-w-0"
              data-astro-prefetch
              aria-current={isActive(`/app/projects/${project.id}`) ? 'page' : undefined}
            >
              <span class="project-dot" style={`--dot: hsl(${projectHue(project.id)} 62% 52%)`}></span>
              <span class="truncate min-w-0">{project.name}</span>
            </a>
            <button
              type="button"
              class="project-type-badge"
              data-project-id={project.id}
              data-type={project.type}
              title={project.type === 'private' ? 'Private — click to mark as Work' : 'Work — click to mark as Private'}
            >
              {project.type === 'private' ? (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3.5" y="7" width="9" height="6" rx="1.3" />
                  <path d="M5.3 7V5.2a2.7 2.7 0 0 1 5.4 0V7" />
                </svg>
              ) : (
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5.3" width="12" height="7.5" rx="1.3" />
                  <path d="M6 5.3V4.3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1M2 9h12" />
                </svg>
              )}
              <span class="sr-only">Toggle private/work</span>
            </button>
            <button class="project-rename icon-btn" data-project-id={project.id} title={`Rename ${project.name}`}>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11.3 2.7a1.2 1.2 0 0 1 1.7 1.7L5.6 12l-2.4.7.7-2.4z" />
              </svg>
              <span class="sr-only">Rename project</span>
            </button>
            <button class="project-delete icon-btn" data-project-id={project.id} title={`Delete ${project.name}`}>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M4 4l8 8M12 4l-8 8" />
              </svg>
              <span class="sr-only">Delete project</span>
            </button>
          </li>
        ))}
      </ul>

      <form method="POST" action={actions.createProject} class="mt-2">
        <label class="sr-only" for="new-project">New project</label>
        <input id="new-project" name="name" placeholder="New project" class="field w-full" required />
      </form>

      <form method="POST" action="/api/auth/signout" class="mt-auto pt-3">
        <button type="submit" class="btn btn--ghost w-full justify-start text-xs">Sign out</button>
      </form>
    </aside>

    <main class="min-w-0 flex-1 px-4 pb-12 md:px-8">
      <slot />
    </main>

    <!-- Read by task-edit.ts to populate the detail modal's project picker —
         every page already fetches this list for the sidebar, so no extra
         request just to move a task between projects. -->
    <script type="application/json" id="projects-data" set:html={JSON.stringify(projects.map((p) => ({ id: p.id, name: p.name }))).replace(/</g, '\\u003c')} />
  </body>
</html>
<script src="../scripts/sidebar.ts"></script>
