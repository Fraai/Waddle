---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sign in · Waddle</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6a80a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Waddle" />
  </head>
  <body class="grid min-h-screen place-items-center p-6">
    <main class="w-full max-w-sm text-center">
      <ul class="task-list mb-6 text-left" aria-hidden="true">
        <li class="task-row" data-priority="1">
          <div class="task-main">
            <input type="checkbox" class="check" disabled tabindex="-1" />
            <span class="task-title">Reply to client about hosting</span>
          </div>
        </li>
        <li class="task-row" data-priority="4">
          <div class="task-main">
            <input type="checkbox" class="check" checked disabled tabindex="-1" />
            <span class="task-title" data-done>Ship this week's deploy</span>
          </div>
        </li>
        <li class="task-row" data-priority="3">
          <div class="task-main">
            <input type="checkbox" class="check" disabled tabindex="-1" />
            <span class="task-title">Plan next sprint</span>
          </div>
        </li>
      </ul>

      <h1 class="page-title">Waddle</h1>
      <p class="mx-auto mt-2 max-w-[26ch] text-sm" style="color: var(--text-2)">
        {env.APP_TAGLINE ?? 'The internal task list for your team.'}
      </p>

      <a href="/api/auth/google" class="btn btn--primary mt-6 w-full">
        <svg viewBox="0 0 18 18" class="h-4 w-4" aria-hidden="true">
          <path fill="#fff" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z" opacity=".9" />
          <path fill="#fff" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" opacity=".75" />
          <path fill="#fff" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z" opacity=".6" />
          <path fill="#fff" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" opacity=".85" />
        </svg>
        Sign in with Google
      </a>

      {env.AUTH_GITHUB_ID && (
        <a href="/api/auth/github" class="btn btn--secondary mt-3 w-full">
          <svg viewBox="0 0 16 16" class="h-4 w-4" aria-hidden="true" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Sign in with GitHub
        </a>
      )}

      {env.AUTH_MICROSOFT_ID && (
        <a href="/api/auth/microsoft" class="btn btn--secondary mt-3 w-full">
          <svg viewBox="0 0 21 21" class="h-4 w-4" aria-hidden="true">
            <rect x="1" y="1" width="9" height="9" fill="#f25022" />
            <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
            <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
            <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
          </svg>
          Sign in with Microsoft
        </a>
      )}

      <p class="mt-3 text-xs" style="color: var(--text-3)">@{env.ALLOWED_EMAIL_DOMAIN} accounts only</p>
    </main>
  </body>
</html>
