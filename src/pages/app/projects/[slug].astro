---
import AppLayout from '../../../layouts/AppLayout.astro';
import { actions } from 'astro:actions';
import { env } from 'cloudflare:workers';
import * as db from '../../../lib/db';
import { withSlugs } from '../../../lib/slug';
import { todayISO } from '../../../lib/dates';
import { formatDate } from '../../../lib/format';
import { repeatRuleLabel } from '../../../lib/repeat';

const user = Astro.locals.user!;
const slug = Astro.params.slug;

const rawProjects = await db.listProjects(env.DB, user.id);
const projects = withSlugs(rawProjects);
const project = projects.find((p) => p.slug === slug);
if (!project) return Astro.redirect('/app/today');
const projectId = project.id;

const [sections, tasks] = await Promise.all([
  db.listSections(env.DB, user.id, projectId),
  db.listTasksByProject(env.DB, user.id, projectId),
]);

const topLevel = tasks.filter((t) => t.parent_task_id === null);
const openTopLevel = topLevel.filter((t) => t.done_at === null);
// Sorted newest-first — recently finished tasks are the ones you're most
// likely to want to glance at (or undo).
const doneTopLevel = topLevel
  .filter((t) => t.done_at !== null)
  .sort((a, b) => (b.done_at! < a.done_at! ? -1 : 1));
const subtasksByParent = new Map<number, typeof tasks>();
for (const t of tasks) {
  if (t.parent_task_id === null) continue;
  const list = subtasksByParent.get(t.parent_task_id) ?? [];
  list.push(t);
  subtasksByParent.set(t.parent_task_id, list);
}

const sectionGroups = [
  { id: null as number | null, name: null as string | null, tasks: openTopLevel.filter((t) => t.section_id === null) },
  ...sections.map((s) => ({ id: s.id, name: s.name, tasks: openTopLevel.filter((t) => t.section_id === s.id) })),
];

const today = todayISO();
const openCount = openTopLevel.length;
---
<AppLayout title={project.name} projects={rawProjects}>
  <div data-project-root={projectId} data-today={today} class="mx-auto max-w-2xl">
    <header class="page-head">
      <h1 class="page-title">{project.name}</h1>
      <p class="mt-1 text-sm" style="color: var(--text-2)" data-open-count={openCount}>
        {openCount === 0 ? 'All clear' : `${openCount} open ${openCount === 1 ? 'task' : 'tasks'}`}
      </p>
    </header>

    <div id="sections-container">
    {sectionGroups.map((group) => (
      <section class="mb-6" data-section-id={group.id ?? ''}>
        {group.name && (
          <h2 class="label-caps mb-2 flex items-center gap-2 section-handle">
            <span class="section-name">{group.name}</span>
            <button class="section-rename icon-btn" data-section-id={group.id} title={`Rename ${group.name}`}>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11.3 2.7a1.2 1.2 0 0 1 1.7 1.7L5.6 12l-2.4.7.7-2.4z" />
              </svg>
              <span class="sr-only">Rename section</span>
            </button>
            <button class="section-delete icon-btn" data-section-id={group.id} title={`Delete ${group.name}`}>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M4 4l8 8M12 4l-8 8" />
              </svg>
              <span class="sr-only">Delete section</span>
            </button>
          </h2>
        )}

        <ul class="task-list" data-section-id={group.id ?? ''} data-remove-done>
          {group.tasks.map((task) => (
            <li
              data-task-id={task.id}
              data-priority={task.priority}
              data-due-date={task.due_date ?? ''}
              data-description={task.description ?? ''}
              data-href={task.href ?? ''}
              data-due-time={task.due_time ?? ''}
              data-repeat-rule={task.repeat_rule ?? ''}
              data-project-id={projectId}
              class="task-row"
            >
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  checked={task.done_at !== null}
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title" data-done={task.done_at ? '' : undefined}>{task.title}</span>
                {task.repeat_rule && (
                  <span class="task-repeat-badge" title={repeatRuleLabel(task.repeat_rule)}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2.5 8a5.5 5.5 0 0 1 9.5-3.8M13.5 8a5.5 5.5 0 0 1-9.5 3.8" />
                      <path d="M12 1.5v2.7h-2.7M4 14.5v-2.7h2.7" />
                    </svg>
                    <span class="sr-only">Repeats: {repeatRuleLabel(task.repeat_rule)}</span>
                  </span>
                )}
                {task.href && (
                  <a class="task-href-badge" href={task.href} target="_blank" rel="noopener" title={task.href}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6.5 9.5 13 3M9 3h4v4M12 9v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3" />
                    </svg>
                    <span class="sr-only">Open link</span>
                  </a>
                )}
                {task.due_date && (
                  <span class:list={['pill', task.due_date < today && !task.done_at && 'pill--overdue']}>
                    {formatDate(task.due_date)}
                  </span>
                )}
                <button class="task-delete icon-btn" data-task-id={task.id} title={`Delete "${task.title}"`}>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <path d="M4 4l8 8M12 4l-8 8" />
                  </svg>
                  <span class="sr-only">Delete task</span>
                </button>
              </div>

              {(subtasksByParent.get(task.id) ?? []).length > 0 && (
                <ul class="subtasks">
                  {(subtasksByParent.get(task.id) ?? []).map((sub) => (
                    <li
                      class="subtask"
                      data-task-id={sub.id}
                      data-priority={sub.priority}
                      data-due-date={sub.due_date ?? ''}
                      data-description={sub.description ?? ''}
                      data-href={sub.href ?? ''}
                      data-repeat-rule={sub.repeat_rule ?? ''}
                    >
                      <div class="task-main">
                        <input
                          type="checkbox"
                          class="task-toggle check"
                          data-task-id={sub.id}
                          checked={sub.done_at !== null}
                          aria-label={`Mark "${sub.title}" done`}
                        />
                        <span class="task-title" data-done={sub.done_at ? '' : undefined}>{sub.title}</span>
                        {sub.repeat_rule && (
                          <span class="task-repeat-badge" title={repeatRuleLabel(sub.repeat_rule)}>
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M2.5 8a5.5 5.5 0 0 1 9.5-3.8M13.5 8a5.5 5.5 0 0 1-9.5 3.8" />
                              <path d="M12 1.5v2.7h-2.7M4 14.5v-2.7h2.7" />
                            </svg>
                            <span class="sr-only">Repeats: {repeatRuleLabel(sub.repeat_rule)}</span>
                          </span>
                        )}
                        {sub.href && (
                          <a class="task-href-badge" href={sub.href} target="_blank" rel="noopener" title={sub.href}>
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M6.5 9.5 13 3M9 3h4v4M12 9v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3" />
                            </svg>
                            <span class="sr-only">Open link</span>
                          </a>
                        )}
                        <button class="task-delete icon-btn" data-task-id={sub.id} title={`Delete "${sub.title}"`}>
                          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                            <path d="M4 4l8 8M12 4l-8 8" />
                          </svg>
                          <span class="sr-only">Delete task</span>
                        </button>
                      </div>
                    </li>
                  ))}
                </ul>
              )}

              <form method="POST" action={actions.createTask} class="subtask-add">
                <input type="hidden" name="projectId" value={projectId} />
                <input type="hidden" name="parentTaskId" value={task.id} />
                <input
                  name="title"
                  placeholder="Add subtask"
                  aria-label="Add subtask"
                  class="w-full border-0 bg-transparent p-0 text-[0.8125rem] outline-none placeholder:text-[var(--text-3)]"
                  required
                />
              </form>
            </li>
          ))}
        </ul>

        {group.tasks.length === 0 && group.name === null && sections.length === 0 && (
          <p class="empty">Nothing here yet. Add your first task below.</p>
        )}

        <form method="POST" action={actions.createTask} class="composer mt-2" data-kind="project">
          <input type="hidden" name="projectId" value={projectId} />
          {group.id !== null && <input type="hidden" name="sectionId" value={group.id} />}
          <input name="title" placeholder="Add task" aria-label="Task title" required />
          <input type="date" name="dueDate" aria-label="Due date" />
          <select name="priority" aria-label="Priority">
            <option value="4" selected>P4</option>
            <option value="3">P3</option>
            <option value="2">P2</option>
            <option value="1">P1</option>
          </select>
          <button type="submit" class="btn btn--submit" title="Add task">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M8 3.5v9M3.5 8h9" />
            </svg>
            <span class="sr-only">Add task</span>
          </button>
        </form>
      </section>
    ))}
    </div>

    <form method="POST" action={actions.createSection} class="mt-6">
      <input type="hidden" name="projectId" value={projectId} />
      <label class="sr-only" for="new-section">New section</label>
      <input id="new-section" name="name" placeholder="Add section" class="field w-56" required />
    </form>

    {doneTopLevel.length > 0 && (
      <details class="mt-8">
        <summary class="label-caps cursor-pointer select-none">Completed ({doneTopLevel.length})</summary>
        <ul class="task-list mt-2">
          {doneTopLevel.map((task) => (
            <li
              data-task-id={task.id}
              data-priority={task.priority}
              data-due-date={task.due_date ?? ''}
              data-description={task.description ?? ''}
              data-href={task.href ?? ''}
              data-due-time={task.due_time ?? ''}
              data-repeat-rule={task.repeat_rule ?? ''}
              data-project-id={projectId}
              class="task-row"
            >
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  checked
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title" data-done>{task.title}</span>
                {task.repeat_rule && (
                  <span class="task-repeat-badge" title={repeatRuleLabel(task.repeat_rule)}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2.5 8a5.5 5.5 0 0 1 9.5-3.8M13.5 8a5.5 5.5 0 0 1-9.5 3.8" />
                      <path d="M12 1.5v2.7h-2.7M4 14.5v-2.7h2.7" />
                    </svg>
                    <span class="sr-only">Repeats: {repeatRuleLabel(task.repeat_rule)}</span>
                  </span>
                )}
                {task.href && (
                  <a class="task-href-badge" href={task.href} target="_blank" rel="noopener" title={task.href}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6.5 9.5 13 3M9 3h4v4M12 9v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3" />
                    </svg>
                    <span class="sr-only">Open link</span>
                  </a>
                )}
                <button class="task-delete icon-btn" data-task-id={task.id} title={`Delete "${task.title}"`}>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <path d="M4 4l8 8M12 4l-8 8" />
                  </svg>
                  <span class="sr-only">Delete task</span>
                </button>
              </div>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>
</AppLayout>
<script src="../../../scripts/task-list.ts"></script>
