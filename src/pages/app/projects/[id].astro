---
import AppLayout from '../../../layouts/AppLayout.astro';
import { actions } from 'astro:actions';
import { env } from 'cloudflare:workers';
import * as db from '../../../lib/db';
import { todayISO } from '../../../lib/dates';
import { formatDate } from '../../../lib/format';

const user = Astro.locals.user!;
const projectId = Number(Astro.params.id);
if (!Number.isInteger(projectId)) return Astro.redirect('/app/today');

const projects = await db.listProjects(env.DB, user.id);
const project = projects.find((p) => p.id === projectId);
if (!project) return Astro.redirect('/app/today');

const [sections, tasks] = await Promise.all([
  db.listSections(env.DB, user.id, projectId),
  db.listTasksByProject(env.DB, user.id, projectId),
]);

const topLevel = tasks.filter((t) => t.parent_task_id === null);
const subtasksByParent = new Map<number, typeof tasks>();
for (const t of tasks) {
  if (t.parent_task_id === null) continue;
  const list = subtasksByParent.get(t.parent_task_id) ?? [];
  list.push(t);
  subtasksByParent.set(t.parent_task_id, list);
}

const sectionGroups = [
  { id: null as number | null, name: null as string | null, tasks: topLevel.filter((t) => t.section_id === null) },
  ...sections.map((s) => ({ id: s.id, name: s.name, tasks: topLevel.filter((t) => t.section_id === s.id) })),
];

const today = todayISO();
const openCount = topLevel.filter((t) => t.done_at === null).length;
---
<AppLayout title={project.name}>
  <div data-project-root={projectId} class="mx-auto max-w-2xl">
    <header class="page-head">
      <h1 class="page-title">{project.name}</h1>
      <p class="mt-1 text-sm" style="color: var(--text-2)" data-open-count={openCount}>
        {openCount === 0 ? 'All clear' : `${openCount} open ${openCount === 1 ? 'task' : 'tasks'}`}
      </p>
    </header>

    {sectionGroups.map((group) => (
      <section class="mb-7">
        {group.name && (
          <h2 class="label-caps mb-2 flex items-center gap-1.5">
            {group.name}
            <button class="section-delete icon-btn" data-section-id={group.id} title={`Delete ${group.name}`}>
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M4 4l8 8M12 4l-8 8" />
              </svg>
              <span class="sr-only">Delete section</span>
            </button>
          </h2>
        )}

        <ul class="task-list" data-section-id={group.id ?? ''}>
          {group.tasks.map((task) => (
            <li data-task-id={task.id} data-priority={task.priority} class="task-row">
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  checked={task.done_at !== null}
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title" data-done={task.done_at ? '' : undefined}>{task.title}</span>
                {task.due_date && (
                  <span class:list={['pill', task.due_date < today && !task.done_at && 'pill--overdue']}>
                    {formatDate(task.due_date)}
                  </span>
                )}
                <button class="task-delete icon-btn" data-task-id={task.id} title={`Delete "${task.title}"`}>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <path d="M4 4l8 8M12 4l-8 8" />
                  </svg>
                  <span class="sr-only">Delete task</span>
                </button>
              </div>

              {(subtasksByParent.get(task.id) ?? []).length > 0 && (
                <ul class="subtasks">
                  {(subtasksByParent.get(task.id) ?? []).map((sub) => (
                    <li class="subtask" data-priority={sub.priority}>
                      <input
                        type="checkbox"
                        class="task-toggle check"
                        data-task-id={sub.id}
                        checked={sub.done_at !== null}
                        aria-label={`Mark "${sub.title}" done`}
                      />
                      <span class="task-title" data-done={sub.done_at ? '' : undefined}>{sub.title}</span>
                    </li>
                  ))}
                </ul>
              )}

              <form method="POST" action={actions.createTask} class="subtask-add ml-[1.75rem] pl-3">
                <input type="hidden" name="projectId" value={projectId} />
                <input type="hidden" name="parentTaskId" value={task.id} />
                <input
                  name="title"
                  placeholder="Add subtask"
                  aria-label="Add subtask"
                  class="w-full border-0 bg-transparent p-0 text-[0.8125rem] outline-none placeholder:text-[var(--text-3)]"
                  required
                />
              </form>
            </li>
          ))}
        </ul>

        {group.tasks.length === 0 && group.name === null && sections.length === 0 && (
          <p class="empty mb-3">Nothing here yet. Add your first task below.</p>
        )}

        <form method="POST" action={actions.createTask} class="composer mt-2">
          <input type="hidden" name="projectId" value={projectId} />
          {group.id !== null && <input type="hidden" name="sectionId" value={group.id} />}
          <input name="title" placeholder="Add task" aria-label="Task title" required />
          <input type="date" name="dueDate" aria-label="Due date" />
          <select name="priority" aria-label="Priority">
            <option value="4" selected>P4</option>
            <option value="3">P3</option>
            <option value="2">P2</option>
            <option value="1">P1</option>
          </select>
          <button type="submit" class="btn btn--submit" title="Add task">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M8 3.5v9M3.5 8h9" />
            </svg>
            <span class="sr-only">Add task</span>
          </button>
        </form>
      </section>
    ))}

    <form method="POST" action={actions.createSection} class="mt-6">
      <input type="hidden" name="projectId" value={projectId} />
      <label class="sr-only" for="new-section">New section</label>
      <input id="new-section" name="name" placeholder="Add section" class="field w-56" required />
    </form>
  </div>
</AppLayout>
<script src="../../../scripts/task-list.ts"></script>
