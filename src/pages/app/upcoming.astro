---
import AppLayout from '../../layouts/AppLayout.astro';
import { actions } from 'astro:actions';
import { env } from 'cloudflare:workers';
import { listOpenDatedTasks, listProjects } from '../../lib/db';
import { todayISO, groupUpcoming } from '../../lib/dates';
import { formatDateHeading } from '../../lib/format';
import { repeatRuleLabel } from '../../lib/repeat';

const user = Astro.locals.user!;
const [tasks, projects] = await Promise.all([
  listOpenDatedTasks(env.DB, user.id),
  listProjects(env.DB, user.id),
]);
const inbox = projects.find((p) => p.is_inbox === 1);
const projectsById = new Map(projects.map((p) => [p.id, p]));
const today = todayISO();
const groups = groupUpcoming(tasks, today);

// Inbox is the catch-all, not a private/work project — omitting the
// attribute (rather than passing its type) keeps its tasks showing no
// matter which the sidebar's filter is set to.
const taskProjectType = (task: { project_id: number }) => {
  const p = projectsById.get(task.project_id);
  return p?.is_inbox ? undefined : p?.type;
};
---
<AppLayout title="Upcoming" projects={projects}>
  <div class="mx-auto max-w-2xl">
    <header class="page-head">
      <h1 class="page-title">Upcoming</h1>
      <p class="mt-1 text-sm" style="color: var(--text-2)">
        {groups.length === 0 ? 'Nothing scheduled' : `${groups.length} ${groups.length === 1 ? 'day' : 'days'} ahead`}
      </p>
    </header>

    {groups.length === 0 && <p class="empty">No upcoming tasks.</p>}

    {groups.map((group) => (
      <section class="mb-6" data-date={group.date}>
        <h2 class="label-caps mb-2">{formatDateHeading(group.date, today)}</h2>
        <ul class="task-list" data-remove-done>
          {group.tasks.map((task) => (
            <li
              data-task-id={task.id}
              data-priority={task.priority}
              data-due-date={task.due_date}
              data-description={task.description ?? ''}
              data-href={task.href ?? ''}
              data-due-time={task.due_time ?? ''}
              data-repeat-rule={task.repeat_rule ?? ''}
              data-project-type={taskProjectType(task)}
              data-project-id={task.project_id}
              class="task-row"
            >
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title">{task.title}</span>
                {task.repeat_rule && (
                  <span class="task-repeat-badge" title={repeatRuleLabel(task.repeat_rule)}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2.5 8a5.5 5.5 0 0 1 9.5-3.8M13.5 8a5.5 5.5 0 0 1-9.5 3.8" />
                      <path d="M12 1.5v2.7h-2.7M4 14.5v-2.7h2.7" />
                    </svg>
                    <span class="sr-only">Repeats: {repeatRuleLabel(task.repeat_rule)}</span>
                  </span>
                )}
                {task.href && (
                  <a class="task-href-badge" href={task.href} target="_blank" rel="noopener" title={task.href}>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6.5 9.5 13 3M9 3h4v4M12 9v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3" />
                    </svg>
                    <span class="sr-only">Open link</span>
                  </a>
                )}
                {task.due_time && (
                  <span class="pill">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="8" cy="8" r="5.5" />
                      <path d="M8 5.2V8l1.9 1.4" />
                    </svg>
                    {task.due_time}
                  </span>
                )}
                <button class="task-delete icon-btn" data-task-id={task.id} title={`Delete "${task.title}"`}>
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <path d="M4 4l8 8M12 4l-8 8" />
                  </svg>
                  <span class="sr-only">Delete task</span>
                </button>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {inbox && (
      <form method="POST" action={actions.createTask} class="composer mt-2" data-kind="upcoming">
        <input type="hidden" name="projectId" value={inbox.id} />
        <input name="title" placeholder="Add task" aria-label="Task title" required />
        <input type="date" name="dueDate" aria-label="Due date" min={today} required />
        <select name="priority" aria-label="Priority">
          <option value="4" selected>P4</option>
          <option value="3">P3</option>
          <option value="2">P2</option>
          <option value="1">P1</option>
        </select>
        <button type="submit" class="btn btn--submit" title="Add task">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
            <path d="M8 3.5v9M3.5 8h9" />
          </svg>
          <span class="sr-only">Add task</span>
        </button>
      </form>
    )}
  </div>
</AppLayout>
<script src="../../scripts/task-toggle.ts"></script>
<script src="../../scripts/task-delete.ts"></script>
<script src="../../scripts/task-edit.ts"></script>
<script src="../../scripts/task-create.ts"></script>
