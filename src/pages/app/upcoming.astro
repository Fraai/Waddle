---
import AppLayout from '../../layouts/AppLayout.astro';
import { env } from 'cloudflare:workers';
import { listOpenDatedTasks } from '../../lib/db';
import { todayISO, groupUpcoming } from '../../lib/dates';
import { formatDateHeading } from '../../lib/format';

const user = Astro.locals.user!;
const tasks = await listOpenDatedTasks(env.DB, user.id);
const today = todayISO();
const groups = groupUpcoming(tasks, today);
---
<AppLayout title="Upcoming">
  <div class="mx-auto max-w-2xl">
    <header class="page-head">
      <h1 class="page-title">Upcoming</h1>
      <p class="mt-1 text-sm" style="color: var(--text-2)">
        {groups.length === 0 ? 'Nothing scheduled' : `${groups.length} ${groups.length === 1 ? 'day' : 'days'} ahead`}
      </p>
    </header>

    {groups.length === 0 && <p class="empty">No upcoming tasks.</p>}

    {groups.map((group) => (
      <section class="mb-6">
        <h2 class="label-caps mb-2">{formatDateHeading(group.date, today)}</h2>
        <ul class="task-list">
          {group.tasks.map((task) => (
            <li data-task-id={task.id} data-priority={task.priority} class="task-row">
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title">{task.title}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</AppLayout>
<script src="../../scripts/task-toggle.ts"></script>
