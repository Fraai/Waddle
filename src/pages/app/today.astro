---
import AppLayout from '../../layouts/AppLayout.astro';
import { env } from 'cloudflare:workers';
import { listOpenDatedTasks } from '../../lib/db';
import { todayISO, splitOverdueAndToday } from '../../lib/dates';
import { formatDate } from '../../lib/format';

const user = Astro.locals.user!;
const tasks = await listOpenDatedTasks(env.DB, user.id);
const today = todayISO();
const { overdue, today: dueToday } = splitOverdueAndToday(tasks, today);
---
<AppLayout title="Today">
  <div class="mx-auto max-w-2xl">
    <header class="page-head">
      <h1 class="page-title">Today</h1>
      <p class="mt-1 text-sm" style="color: var(--text-2)">{formatDate(today)}</p>
    </header>

    {overdue.length > 0 && (
      <section class="mb-7">
        <h2 class="label-caps mb-2" style="color: var(--danger)">Overdue</h2>
        <ul class="task-list">
          {overdue.map((task) => (
            <li data-task-id={task.id} data-priority={task.priority} class="task-row">
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title">{task.title}</span>
                <span class="pill pill--overdue">{formatDate(task.due_date!)}</span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="label-caps mb-2">Due today</h2>
      {dueToday.length === 0 ? (
        <p class="empty">Nothing due today.</p>
      ) : (
        <ul class="task-list">
          {dueToday.map((task) => (
            <li data-task-id={task.id} data-priority={task.priority} class="task-row">
              <div class="task-main">
                <input
                  type="checkbox"
                  class="task-toggle check"
                  data-task-id={task.id}
                  aria-label={`Mark "${task.title}" done`}
                />
                <span class="task-title">{task.title}</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</AppLayout>
<script src="../../scripts/task-toggle.ts"></script>
